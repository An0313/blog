---
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { title, date, tags, permalink } = post.data;
const href = permalink || `/${post.id}/`;
const dateStr = date.toISOString().slice(0, 10);
---
<li class="post-item">
  <a class="post-item-title" href={href}>{title}</a>
  <div class="post-item-meta">
    <time datetime={date.toISOString()}>{dateStr}</time>
    {tags.length > 0 && (
      <span class="post-item-tags">
        {tags.map(t => <a class="tag-chip" href={`/tags/${encodeURIComponent(t)}/`}>{t}</a>)}
      </span>
    )}
  </div>
</li>
