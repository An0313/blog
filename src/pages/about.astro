---
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
const { about, github, email, name } = site;
---
<BaseLayout title={`关于 | ${name}`} description={about.lead}>
  <div class="about-page">
    <h1>{name}</h1>
    <p class="lead">{about.lead}</p>

    <section class="about-section">
      <h2>技术栈</h2>
      <div class="stack-grid">
        {about.stack.map(s => (
          <div class="stack-item">
            <span class="name">{s.name}</span>
            <span class="desc">{s.desc}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="about-section">
      <h2>当前关注</h2>
      <ul>
        {about.focus.map(f => <li>{f}</li>)}
      </ul>
    </section>

    <section class="about-section">
      <h2>经历</h2>
      <div class="timeline">
        {about.timeline.map(t => (
          <div class="timeline-item">
            <div class="when">{t.when}</div>
            <div class="what">{t.what}</div>
            <div class="why">{t.why}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="about-section">
      <h2>联系</h2>
      <p>
        GitHub: <a href={github} target="_blank" rel="noopener">{github.replace('https://','')}</a><br />
        Email: <a href={`mailto:${email}`}>{email}</a>
      </p>
      <p style="margin-top:16px;">
        <a class="btn btn-primary" href="/">← 返回首页</a>
      </p>
    </section>
  </div>
</BaseLayout>
